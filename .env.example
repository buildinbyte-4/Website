NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Set this to a header that your hosting proxy overwrites (for example,
# x-vercel-forwarded-for on Vercel or cf-connecting-ip on Cloudflare).
TRUSTED_PROXY_IP_HEADER=

# Optional: receive a JSON POST after an inquiry is stored successfully.
INQUIRY_WEBHOOK_URL=

# Optional: forward sanitized browser error events to your monitoring provider.
ERROR_REPORTING_WEBHOOK_URL=

# Server-only keys. Never add a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
